# =============================================================================
# KubeSentient - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Anthropic API Key (reasoning LLM)
# Get yours at: https://console.anthropic.com/settings/keys
# Used by: LangGraph investigator + planner nodes (Claude Sonnet 4.6)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default Claude model
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# REQUIRED: OpenAI API Key (embeddings only)
# Used solely by Weaviate's text2vec-openai module to embed runbook chunks.
# The agent's reasoning runs on Claude; this key never sees user prompts.
# Get yours at: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# -----------------------------------------------------------------------------
# Weaviate Vector Database URL
# Default points to the local docker-compose service.
# In Kubernetes, this is injected automatically by the Helm chart.
# -----------------------------------------------------------------------------
WEAVIATE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Kubernetes Config (local development only)
# Leave blank to use the default ~/.kube/config location.
# In-cluster (Kubernetes Pod): automatically uses ServiceAccount token.
# -----------------------------------------------------------------------------
# KUBECONFIG=/home/user/.kube/config

# -----------------------------------------------------------------------------
# Application Settings (optional overrides)
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
