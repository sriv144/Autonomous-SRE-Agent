# =============================================================================
# KubeSentient - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Selection
# Choose which chat backend the LangGraph agent uses.
#   - openai     : ChatOpenAI (default; keeps existing behaviour)
#   - anthropic  : ChatAnthropic (Claude)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# REQUIRED when LLM_PROVIDER=openai: OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# Used by: LangGraph agent (gpt-4-turbo-preview) + Weaviate text2vec-openai
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# OpenAI model to use for the agent (only when LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4-turbo-preview

# -----------------------------------------------------------------------------
# REQUIRED when LLM_PROVIDER=anthropic: Anthropic API Key
# Get yours at: https://console.anthropic.com/
# Used by: LangGraph agent (claude-sonnet-4-6)
# Note: Weaviate's text2vec-openai module still needs OPENAI_API_KEY for
# runbook embeddings, even when the agent itself runs on Claude.
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Anthropic model to use for the agent (only when LLM_PROVIDER=anthropic)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Weaviate Vector Database URL
# Default points to the local docker-compose service.
# In Kubernetes, this is injected automatically by the Helm chart.
# -----------------------------------------------------------------------------
WEAVIATE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Kubernetes Config (local development only)
# Leave blank to use the default ~/.kube/config location.
# In-cluster (Kubernetes Pod): automatically uses ServiceAccount token.
# -----------------------------------------------------------------------------
# KUBECONFIG=/home/user/.kube/config

# -----------------------------------------------------------------------------
# Application Settings (optional overrides)
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
