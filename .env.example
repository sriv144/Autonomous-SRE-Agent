# =============================================================================
# KubeSentient - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Selection
#   openai     -> ChatOpenAI (gpt-4-turbo-preview by default)
#   anthropic  -> ChatAnthropic (claude-sonnet-4-6 by default)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# REQUIRED when LLM_PROVIDER=openai
# Get yours at: https://platform.openai.com/api-keys
# Also used by Weaviate text2vec-openai for embeddings.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# Optional model override
OPENAI_MODEL=gpt-4-turbo-preview

# -----------------------------------------------------------------------------
# REQUIRED when LLM_PROVIDER=anthropic
# Get yours at: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Optional model override. Examples:
#   claude-opus-4-7        (highest capability)
#   claude-sonnet-4-6      (default; balanced reasoning + cost)
#   claude-haiku-4-5-20251001  (cheapest)
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Weaviate Vector Database URL
# Default points to the local docker-compose service.
# In Kubernetes, this is injected automatically by the Helm chart.
# NOTE: Weaviate's text2vec-openai vectorizer still requires OPENAI_API_KEY
# even when LLM_PROVIDER=anthropic. Set both keys when running RAG.
# -----------------------------------------------------------------------------
WEAVIATE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Kubernetes Config (local development only)
# Leave blank to use the default ~/.kube/config location.
# In-cluster (Kubernetes Pod): automatically uses ServiceAccount token.
# -----------------------------------------------------------------------------
# KUBECONFIG=/home/user/.kube/config

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
