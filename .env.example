# =============================================================================
# KubeSentient - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# Used by: LangGraph agent (gpt-4-turbo-preview) + Weaviate text2vec-openai
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# -----------------------------------------------------------------------------
# Weaviate Vector Database URL
# Default points to the local docker-compose service.
# In Kubernetes, this is injected automatically by the Helm chart.
# -----------------------------------------------------------------------------
WEAVIATE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Kubernetes mode
# Set K8S_LOCAL_MODE=true for local development so the K8s tools load your
# local kubeconfig (~/.kube/config or $KUBECONFIG). Leave false/unset to use
# the in-cluster ServiceAccount token (the default when running inside a Pod).
# Accepted truthy values: 1, true, yes, on.
# -----------------------------------------------------------------------------
K8S_LOCAL_MODE=false

# -----------------------------------------------------------------------------
# Kubernetes Config (local development only)
# Leave blank to use the default ~/.kube/config location.
# In-cluster (Kubernetes Pod): automatically uses ServiceAccount token.
# -----------------------------------------------------------------------------
# KUBECONFIG=/home/user/.kube/config

# -----------------------------------------------------------------------------
# Application Settings (optional overrides)
# -----------------------------------------------------------------------------
# OpenAI model to use for the agent
OPENAI_MODEL=gpt-4-turbo-preview

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
