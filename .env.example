# =============================================================================
# KubeSentient - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Anthropic API Key
# Get yours at: https://console.anthropic.com/settings/keys
# Used by: LangGraph agent reasoning (claude-sonnet-4-6 by default)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# -----------------------------------------------------------------------------
# REQUIRED: OpenAI API Key (vector embeddings only)
# Get yours at: https://platform.openai.com/api-keys
# Used by: Weaviate text2vec-openai module to embed runbook chunks.
# The agent itself no longer calls OpenAI for reasoning.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# -----------------------------------------------------------------------------
# Weaviate Vector Database URL
# Default points to the local docker-compose service.
# In Kubernetes, this is injected automatically by the Helm chart.
# -----------------------------------------------------------------------------
WEAVIATE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Kubernetes Config (local development only)
# Leave blank to use the default ~/.kube/config location.
# In-cluster (Kubernetes Pod): automatically uses ServiceAccount token.
# -----------------------------------------------------------------------------
# KUBECONFIG=/home/user/.kube/config

# -----------------------------------------------------------------------------
# Application Settings (optional overrides)
# -----------------------------------------------------------------------------
# Claude model to use for the agent.
# Recommended: claude-sonnet-4-6 (fast, strong reasoning).
# For harder incidents: claude-opus-4-8.
# For low-latency triage: claude-haiku-4-5.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
