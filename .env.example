# =============================================================================
# KubeSentient - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# Used by: LangGraph agent (gpt-4-turbo-preview) + Weaviate text2vec-openai
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# -----------------------------------------------------------------------------
# Weaviate Vector Database URL
# Default points to the local docker-compose service.
# In Kubernetes, this is injected automatically by the Helm chart.
# -----------------------------------------------------------------------------
WEAVIATE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Kubernetes Config (local development only)
# Leave blank to use the default ~/.kube/config location.
# In-cluster (Kubernetes Pod): automatically uses ServiceAccount token.
# -----------------------------------------------------------------------------
# KUBECONFIG=/home/user/.kube/config

# -----------------------------------------------------------------------------
# K8s client mode selector (consumed by src/agent_core/tools.py)
# false (default): use in-cluster ServiceAccount config. Correct for Helm/Pod.
# true:            use the kubeconfig at $KUBECONFIG / ~/.kube/config.
# Accepts: 1, true, yes, on (case-insensitive)
# -----------------------------------------------------------------------------
KUBESENTIENT_LOCAL_MODE=false

# -----------------------------------------------------------------------------
# Application Settings (optional overrides)
# -----------------------------------------------------------------------------
# OpenAI model to use for the agent
OPENAI_MODEL=gpt-4-turbo-preview

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
