# =============================================================================
# KubeSentient .gitignore
# =============================================================================

# Secrets — NEVER commit these
.env
*.pem
*.key
*.crt
kubeconfig
kubeconfig.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/

# Poetry
poetry.lock

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Type checking
.mypy_cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docker
*.tar

# Weaviate local data (if running outside Docker)
weaviate-data/

# Logs
*.log
logs/
